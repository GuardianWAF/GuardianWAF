# Copy to .env, chmod 600 .env, then fill in all three required values.
# Generate two independent keys with: openssl rand -hex 32
GWAF_UPSTREAM_URL=
GWAF_DASHBOARD_API_KEY=
GWAF_DASHBOARD_ADMIN_KEY=

# Required only for origins on private/reserved networks. Allow the narrowest
# CIDR(s) containing your origin; comma-separated. Empty allows public IPs only.
GWAF_ALLOWED_UPSTREAM_CIDRS=
