# GuardianWAF repository ignore rules

# Go binaries and native build products
/guardianwaf
/guardianwaf.exe
/gwaf
/gwaf.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build and release output
/dist/
/bin/
/build/
/out/
internal/dashboard/dist/
!internal/dashboard/dist/
internal/dashboard/dist/*
!internal/dashboard/dist/placeholder.txt

# Go test, coverage, profiling, and benchmark output
*.test
*.out
*.coverprofile
coverage/
.coverage/
.coverage-*/
coverage*.html
coverage*.json
coverage*.out
coverage*.txt
coverage*.xml
lcov.info
*.lcov
/.nyc_output/
tmpcov*
*.prof
cpu.prof
mem.prof
*.pprof
*.bench
*.trace

# Generic test reports
junit*.xml
test-results/
playwright-report/

# Go
vendor/
go.work
go.work.sum

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
/.project/
/.settings/
/.classpath
*.code-workspace

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Environment files and local secrets
.env
.env.*
!.env.example
!.env.*.example
*.local
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
secrets.yml

# Logs and local runtime state
*.log
*.log.*
*.jsonl
events.jsonl
/logs/
*.pid
*.pid.lock
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
/internal/ai/data/

# ACME / TLS cache
/acme/
/.acme/
/certs/

# Temporary files and caches
*.bak
*.orig
*.tmp
/.cache/
/.gocache/
/.gomodcache/
/.tmp/
/tmp/
/temp/
/.temp_files/

# Containers and release tooling
.docker/

# JavaScript dependencies, caches, and build output
**/node_modules/
**/.vite/
**/.eslintcache
**/*.tsbuildinfo
/website/dist/
/internal/dashboard/ui/dist/
/internal/dashboard/ui/coverage/

# Browser and E2E output
/.playwright-mcp/
/internal/dashboard/ui/test-results/
/internal/dashboard/ui/playwright-report/
/tests/e2e/playwright/test-results/
/tests/e2e/playwright/reports/
/tests/e2e/playwright/playwright-report/

# Local AI/editor/tooling state
/.claude/
/.codebase-index/
/.dfmt/
/.wrongstack/

# AI remediation generated rules (thousands of JSON files)
/internal/ai/remediation/data/remediation/*.json

# GeoIP downloads used during local tests must live in a temporary directory.
/internal/geoip/*-test.csv

# Point-in-time security scanner output; keep only consolidated reports.
/security-report/sc-*-results.md
*.sarif
