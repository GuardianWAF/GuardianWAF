# ========================
# GuardianWAF .gitignore
# ========================

# Binaries (root only, not cmd/guardianwaf/)
/guardianwaf
/guardianwaf.exe
/gwaf
/gwaf.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Build output
/dist/
/bin/
/out/
internal/dashboard/dist/
!internal/dashboard/dist/
internal/dashboard/dist/*
!internal/dashboard/dist/placeholder.txt

# WrongStack LSP / tooling artifacts
/.codebase-index/

# Test output
*.test
*.out
coverage.html
coverage.txt
coverage.out
*.prof
cpu.prof
mem.prof
*.pprof
testdata/fuzz/

# Go
vendor/
go.work
go.work.sum

# IDE / Editors
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
.project
.settings/
.classpath
*.code-workspace

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Environment / Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
secrets.yml

# Logs
*.log
*.jsonl
events.jsonl
/logs/

# ACME / TLS cache
/acme/
/.acme/
/certs/

# Temporary
tmp/
temp/
.tmp/

# Docker
.docker/

# GoReleaser
/dist/

# Benchmark results
*.bench

# Website
website/node_modules/
website/dist/

# Playwright MCP
.playwright-mcp/

# Claude Code
.claude/
internal/dashboard/ui/node_modules/
internal/dashboard/ui/dist/
internal/dashboard/ui/test-results/
internal/dashboard/ui/playwright-report/
internal/dashboard/ui/tsconfig.tsbuildinfo
data/

# E2E Playwright harness (generated by `make e2e`)
tests/e2e/playwright/node_modules/
tests/e2e/playwright/test-results/
tests/e2e/playwright/reports/
tests/e2e/playwright/playwright-report/

# AI remediation generated rules (thousands of JSON files)
internal/ai/remediation/data/remediation/*.json

.dfmt/
.wrongstack/
!/.wrongstack/
/.wrongstack/*
!/.wrongstack/project.json

# Local scratch worktrees (were committed as broken gitlinks with no .gitmodules)
.temp_files/
